{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Product catalogue response",
  "description": "Draft-04 on purpose: the validator bundled with REST Assured (json-schema-validator) implements draft-04, so writing draft-07 here would fail at runtime rather than catch a real contract break.",
  "type": "object",
  "required": ["products", "currency", "taxRate"],
  "additionalProperties": false,
  "properties": {
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "taxRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "price", "stock", "rating"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ATL-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["backpacks", "clothing", "electronics", "equipment"]
          },
          "price": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
          "stock": { "type": "integer", "minimum": 0 },
          "rating": { "type": "number", "minimum": 0, "maximum": 5 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
